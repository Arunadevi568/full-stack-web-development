BT 1 0 0 1 0 267.4 Tm /F4 8 Tf 10.2 TL (// Function to change the content) Tj T* (function changeContent\(\) {) Tj T* (    document.getElementById\("title"\).innerHTML =) Tj T* (        "Content Changed Successfully!";) Tj T* (    document.getElementById\("message"\).innerHTML =) Tj T* (        "The content has been changed using JavaScript.";) Tj T* (}) Tj T*  T* (// Function to change the style) Tj T* (function changeStyle\(\) {) Tj T* (    document.getElementById\("title"\).style.color = "#7c3aed";) Tj T* (    document.getElementById\("title"\).style.fontSize = "45px";) Tj T* (    document.getElementById\("title"\).style.fontFamily = "Georgia, serif";) Tj T* (    document.getElementById\("message"\).style.backgroundColor = "#fce7f3";) Tj T* (    document.getElementById\("message"\).style.color = "#831843";) Tj T* (    document.getElementById\("message"\).style.fontSize = "20px";) Tj T* (    document.getElementById\("message"\).style.fontFamily = "Georgia, serif";) Tj T* (    document.getElementById\("message"\).style.padding = "20px";) Tj T* (}) Tj T*  T* (// Function to change the attributes) Tj T* (function changeAttribute\(\) {) Tj T* (    var msg = document.getElementById\("message"\);) Tj T* (    msg.setAttribute\("title", "Attribute changed using JavaScript"\);) Tj T* (    msg.setAttribute\("data-status", "updated"\);) Tj T* (    console.log\(msg.getAttribute\("title"\)\);   // read the new value) Tj T* (}) Tj T* ET

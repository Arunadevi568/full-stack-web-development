BT 1 0 0 1 6 334.8 Tm /F5 8.2 Tf 9.8 TL (// File Management using the Node.js File System \(fs\) module) Tj T* (const fs = require\('fs'\);) Tj T* (const readline = require\('readline'\);) Tj T*  T* (const rl = readline.createInterface\({ input: process.stdin }\);) Tj T* (const lines = rl[Symbol.asyncIterator]\(\);) Tj T*  T* (// Show a prompt and wait for the user to type one line) Tj T* (async function ask\(question\) {) Tj T* (  process.stdout.write\(question\);) Tj T* (  const { value } = await lines.next\(\);) Tj T* (  return value === undefined ? '' : value;) Tj T* (}) Tj T*  T* (async function main\(\) {) Tj T* (  console.log\('===== Node.js File Management ====='\);) Tj T*  T* (  // 1. Accept the filename and validate it) Tj T* (  const filename = \(await ask\('Enter filename: '\)\).trim\(\);) Tj T* (  if \(filename === ''\) {) Tj T* (    console.log\('Error: Filename is required'\);) Tj T* (    return;) Tj T* (  }) Tj T* (  const fileExists = fs.existsSync\(filename\);) Tj T*  T* (  // 2. Accept the content, then create / write the file) Tj T* (  const content = await ask\('Enter content: '\);) Tj T* (  if \(content.trim\(\) === ''\) {) Tj T* (    if \(!fileExists\) {) Tj T* (      console.log\('Error: Content cannot be empty'\);) Tj T* (      return;) Tj T* (    }) Tj T* (    console.log\('No new content entered. Existing file is kept as it is.'\);) Tj T* (  } else {) Tj T* (    fs.writeFileSync\(filename, content\);) Tj T* ET
Q
 

